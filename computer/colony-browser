#!/bin/sh
# Starts the Bot's browser if it isn't running: a real Chromium window on the Bot's desktop
# (so you see it on the Screen), driven by Colony over the DevTools protocol on port 9223
# (published only to the PC's loopback). Logins persist in /browser.
set -e

if ! pgrep -x chromium >/dev/null 2>&1; then
  install -d -o cua -g cua /browser/profile
  rm -f /browser/profile/SingletonLock /browser/profile/SingletonSocket /browser/profile/SingletonCookie
  # Runs as the desktop user on the desktop's display. The container is the sandbox
  # (Chromium's own sandbox needs privileges we drop).
  su cua -s /bin/sh -c 'DISPLAY=:1 HOME=/home/cua nohup chromium --no-sandbox --disable-dev-shm-usage \
    --remote-debugging-port=9222 --user-data-dir=/browser/profile \
    --window-size=1280,760 --window-position=0,28 --no-first-run --no-default-browser-check \
    --password-store=basic --lang=en-US about:blank >/tmp/chromium.log 2>&1 &'
fi

if ! pgrep -x socat >/dev/null 2>&1; then
  nohup socat TCP-LISTEN:9223,fork,reuseaddr TCP:127.0.0.1:9222 >/dev/null 2>&1 &
fi

i=0
while [ $i -lt 100 ]; do
  if curl -sf http://127.0.0.1:9222/json/version >/dev/null; then exit 0; fi
  i=$((i + 1))
  sleep 0.2
done
echo "The browser didn't start:" >&2
tail -n 20 /tmp/chromium.log >&2
exit 1
