{
  "name": "colony-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit && tsc -p convex --noEmit",
    "backend": "convex dev",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test": "vitest run",
    "setup:workspace": "node scripts/setup-workspace.mjs",
    "search:start": "docker compose -f firecrawl-mcp.compose.yml up -d",
    "search:check": "node scripts/check-search.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@auth/core": "^0.41.3",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/agent": "^0.7.7",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ai": "^7.0.139",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "lucide-react": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
