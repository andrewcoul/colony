# Optional: copy to .env. Models need no settings here: sign in to ChatGPT or OpenCode in the app (Settings).

# For development: a keyless OpenAI-compatible server (Ollama, LM Studio…) offered beside the sign-ins.
# COLONY_DEV_BASE_URL=http://localhost:11434/v1
# COLONY_DEV_MODELS=qwen3:8b

# Your self-hosted Firecrawl API (web search + page reading).
COLONY_FIRECRAWL_URL=http://127.0.0.1:3002

# Where Bots, memory, skills and the database live.
COLONY_DATA_DIR=data

# Keep 127.0.0.1 and expose it to your devices with `tailscale serve` (see README).
COLONY_HOST=127.0.0.1
COLONY_PORT=8787
# Optional: your tailnet logins (comma-separated). They sign in as the admin; other tailnet logins are
# refused. Empty = the first login seen is recorded as yours.
COLONY_ALLOWED_USERS=
# Optional: Cloudflare Access in front of a Cloudflare Tunnel to Colony. Tunnel requests are refused
# unless both are set and the Access email is allowed (comma-separated; empty = COLONY_ALLOWED_USERS).
# Each allowed email gets its own account (a member, with their own Bots) on first sign-in.
# COLONY_CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# COLONY_CF_ACCESS_AUD=
# COLONY_CF_ACCESS_ALLOWED_EMAILS=
# Emails that sign in as the admin (Settings, sign-ins, accounts, PCs, updates; your existing Bots).
# Unset = no email is the admin: through Cloudflare Access you'd sign in as a new member.
# COLONY_ADMIN_EMAILS=you@example.com
# How many Bot computers a member may have running at once (the admin has no limit).
# COLONY_MEMBER_MAX_COMPUTERS=2
# Optional: contact sent to push services with notifications (mailto: or https:).
# COLONY_PUSH_CONTACT=mailto:you@example.com
# Switch off Bot computers after this many idle minutes (0 keeps them on).
# COLONY_COMPUTER_IDLE_MINUTES=5
