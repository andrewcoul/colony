{
  "name": "colony-desktop",
  "productName": "Colony",
  "version": "0.3.0",
  "private": true,
  "description": "Colony for your desktop: your self-hosted team of AI Bots, in its own window.",
  "author": "Andrew Coulson",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "io.github.andrewcoul.colony",
    "productName": "Colony",
    "artifactName": "Colony-Setup-${version}.${ext}",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**", "connect.html", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false, "shortcutName": "Colony" },
    "publish": [{ "provider": "github", "owner": "andrewcoul", "repo": "colony", "releaseType": "release" }]
  }
}
